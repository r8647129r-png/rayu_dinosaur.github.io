# Vercel の Settings → Environment Variables に同じ名前で登録してください（ローカルは .env.local）
# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）で発行：宿の最安料金を表示
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイトID：宿リンクが自動でアフィリエイトリンクになる
RAKUTEN_AFFILIATE_ID=
# ホットペッパーグルメ Webサービス（https://webservice.recruit.co.jp/）で発行：周辺飲食店とクーポンを表示
HOTPEPPER_API_KEY=
